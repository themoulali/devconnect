// use prisma-8

model User {
  id                   String               @id @default(uuid())
  email                String               @unique
  password             String?
  name                 String
  createdAt            temporal.createdAtString()
  updatedAt            temporal.updatedAtString()
  projects             Project[]
  blogPosts            BlogPost[]
  skills               UserSkill[]
  endorsementsGiven    Endorsement[]        @relation("EndorsementsGiven")
  endorsementsReceived Endorsement[]        @relation("EndorsementsReceived")
  connectionsSent      Connection[]         @relation("ConnectionRequester")
  connectionsReceived  Connection[]         @relation("ConnectionReceiver")
}

model Project {
  id          String               @id @default(uuid())
  title       String
  description String
  techStack   String[]
  liveUrl     String?
  repoUrl     String?
  createdAt   DateTime             @default(now())
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
}

model BlogPost {
  id        String   @id @default(uuid())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Skill {
  id           String        @id @default(uuid())
  name         String        @unique
  users        UserSkill[]
  endorsements Endorsement[]
}

model UserSkill {
  userId  String
  skillId String

  user    User   @relation(fields: [userId], references: [id])
  skill   Skill  @relation(fields: [skillId], references: [id])

  @@id([userId, skillId])
}

model Endorsement {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  endorserId     String
  endorsedUserId String
  skillId        String

  endorser       User     @relation("EndorsementsGiven", fields: [endorserId], references: [id])
  endorsedUser   User     @relation("EndorsementsReceived", fields: [endorsedUserId], references: [id])
  skill          Skill    @relation(fields: [skillId], references: [id])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

model Connection {
  id          String               @id @default(uuid())
  status      ConnectionStatus
  createdAt   DateTime             @default(now())
  requesterId String
  requester   User                 @relation("ConnectionRequester", fields: [requesterId], references: [id])
  receiverId  String
  receiver    User                 @relation("ConnectionReceiver", fields: [receiverId], references: [id])

  @@unique([requesterId, receiverId])
}